# Copy to `.env` and fill in as needed. All are OPTIONAL for the local demo.

# WalletConnect Cloud projectId — enables the WalletConnect QR option in the
# RainbowKit modal. Injected wallets (MetaMask) work WITHOUT this, so the local
# demo needs nothing here. Get one free at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Creditcoin CC3-testnet (the "parameterized" second network).
# The local Hardhat network (chainId 31337) is read automatically from
# ../deployment.json — you do NOT configure it here.
#
# Chain ID, RPC, and explorer below are REAL and confirmed reachable (not
# placeholders) — see README.md's "Real testnet deployment" section for how.
# The contract addresses are still blank until you actually deploy: run
# `npx hardhat run scripts/deploy-testnet.js --network creditcoinTestnet`
# from the repo root (needs CC3_TESTNET_PRIVATE_KEY — see root .env.example),
# then copy the four addresses out of the deployment.testnet.json it writes.
# ---------------------------------------------------------------------------
VITE_CC_TESTNET_CHAIN_ID=102031
VITE_CC_TESTNET_NAME=Creditcoin Testnet
VITE_CC_TESTNET_RPC=https://rpc.cc3-testnet.creditcoin.network
VITE_CC_TESTNET_EXPLORER=https://creditcoin-testnet.blockscout.com
VITE_CC_TESTNET_SATELLITE_ID=SAT-014
# Addresses from your CC3-testnet deploy (leave blank until deployed):
VITE_CC_TESTNET_ESCROW=
VITE_CC_TESTNET_ASC=
VITE_CC_TESTNET_SETTLEMENT=
VITE_CC_TESTNET_SOURCE=

# The always-on Oracle Worker backend (oracle-worker/worker.js, hosted
# somewhere persistent — e.g. Render) that lets "Trigger outage" work on
# testnet without a browser-held private key. Leave blank and the button
# just won't show as available on this network. See README's "Public
# testnet demo (Oracle Worker)" section for how to deploy one.
VITE_ORACLE_WORKER_URL=
