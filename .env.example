# Copy to .env and fill in to deploy to Creditcoin's real CC3-testnet with
# scripts/deploy-testnet.js. Nothing here is needed for the local demo
# (scripts/deploy.js) — that uses Hardhat's own auto-funded accounts.

# Required. A funded testnet deployer key. Fund this address from a
# Creditcoin CC3-testnet faucet before running deploy-testnet.js — see
# README.md's "Real testnet deployment" section. Never commit a real key.
CC3_TESTNET_PRIVATE_KEY=

# Optional — override the RPC if Creditcoin's default ever moves.
# Confirmed reachable and correct (chain ID 102031) as of this handoff.
CC3_TESTNET_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Optional — give operator/oracle/treasury/subscriber their own funded
# wallets instead of defaulting every role to the deployer address.
CC3_OPERATOR_ADDRESS=
CC3_ORACLE_ADDRESS=
CC3_TREASURY_ADDRESS=
CC3_SUBSCRIBER_ADDRESS=
